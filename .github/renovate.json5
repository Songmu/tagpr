{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  enabledManagers: [
    'custom.regex',
    'gomod',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Update the Hugo version used to build the documentation site',
      managerFilePatterns: [
        '/^docs\\/site\\/\\.hugo-version$/',
      ],
      matchStrings: [
        '^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$',
      ],
      depNameTemplate: 'gohugoio/hugo',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'gomod',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'require',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: true,
      postUpdateOptions: [
        'gomodUpdateImportPaths',
      ],
      automerge: false,
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchFileNames: [
        'docs/site/go.mod',
      ],
      enabled: false,
    },
    {
      matchDepNames: [
        'gohugoio/hugo',
      ],
      schedule: [
        'before 6am on monday',
      ],
    },
  ],
}
