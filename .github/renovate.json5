{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  // Dependabot continues to manage Go minor/patch updates and GitHub Actions.
  "enabledManagers": [
    "custom.regex",
    "gomod"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Hugo version used to build the documentation site",
      "fileMatch": [
        "^docs\\/site\\/\\.hugo-version$"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"
      ],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain",
        "indirect"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "require"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "require"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": true,
      "postUpdateOptions": [
        "gomodUpdateImportPaths"
      ],
      "automerge": false
    },
    // Package rules merge in order; this later enabled: false overrides the major rule for docs/site/go.mod.
    {
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "docs/site/go.mod"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "gohugoio/hugo"
      ],
      "schedule": [
        "before 6am on monday"
      ]
    }
  ]
}
